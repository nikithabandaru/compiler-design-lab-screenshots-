#include <stdio.h>
#include <string.h>

int main() {
    char str[200];

    printf("Enter a line: ");
    fgets(str, sizeof(str), stdin);

    if(strncmp(str, "//", 2) == 0)
        printf("Single line comment");
    else if(strncmp(str, "/*", 2) == 0)
        printf("Multi line comment");
    else
        printf("Not a comment");

    return 0;
}
